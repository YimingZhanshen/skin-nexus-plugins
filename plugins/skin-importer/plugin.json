{
  "name": "skin-importer",
  "version": "1.0.0",
  "hookApi": 2,
  "entrypoint": "index.js",
  "title": "皮肤导入",
  "author": "SkinNexus",
  "description": "按 Mojang 用户名或 Blessing /skinlib/show/{id} 链接导入皮肤/披风到个人纹理库，可选应用到角色。",
  "permissions": [
    "http:routes:session",
    "net:http",
    "textures:write",
    "players:read",
    "players:write",
    "ui:page",
    "ui:assets"
  ],
  "routes": [
    { "method": "GET", "path": "/players", "tier": "session", "rateLimit": "60/m" },
    { "method": "POST", "path": "/import/mojang", "tier": "session", "csrf": true, "rateLimit": "10/m", "timeoutMS": 10000 },
    { "method": "POST", "path": "/import/blessing", "tier": "session", "csrf": true, "rateLimit": "10/m", "timeoutMS": 10000 }
  ],
  "net": {
    "http": {
      "hosts": ["api.mojang.com", "sessionserver.mojang.com", "textures.minecraft.net"],
      "allowUserHosts": true,
      "userHostPaths": ["/skinlib/info/", "/textures/"],
      "maxBytes": 2097152,
      "timeoutMS": 4000
    }
  },
  "ui": {
    "assets": "ui/",
    "pages": [
      {
        "id": "import",
        "path": "/ext/skin-importer/import",
        "area": "user",
        "nav": { "label": "导入皮肤" },
        "render": { "type": "iframe", "src": "import.html" },
        "perm": 0
      }
    ],
    "i18n": {
      "zh-CN": { "title": "导入皮肤" },
      "en": { "title": "Import skins" }
    }
  },
  "minServer": ">=0.5.0",
  "requires": { "plugins": {}, "server": ">=0.5.0" }
}
